{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.2.0",
  "description": "智能解析网页视频，并在解析失败时自动回退到浏览器捕获的 MP4、WebM、M3U8/HLS、DASH 等媒体流。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
