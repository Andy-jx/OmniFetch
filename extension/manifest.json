{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.3.0",
  "description": "像媒体嗅探器一样自动捕获网页中的 MP4、WebM、HLS/M3U8、DASH 等资源，图标角标显示捕获数量并支持一键保存。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
