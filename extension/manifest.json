{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.6.2",
  "description": "稳定版媒体下载助手：播放后同时保留多条真实媒体候选；HLS 下载后会剥离异常 PNG/垃圾包装、重建标准 H.264/AAC MP4，并严格校验时长与可播放性。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "tabCapture",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background_v11.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_v11.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
