{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.6.1",
  "description": "稳定版媒体下载助手：播放后同时保留多条真实媒体候选，按协议选择下载链路；M3U8 自动换源、直连视频自动探测最高画质，并在保存前校验文件大小、分辨率、时长和可播放性。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "tabCapture",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background_v11.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_v11.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
