{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.5.10",
  "description": "网页媒体嗅探下载器：M3U8 原生分片下载后重建本地 HLS 时间线，并校验最终视频时长，修复文件大小正常但只能播放几秒的问题；继续优先最高画质并支持单独音频。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "tabCapture",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background_v6.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
