{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.4.0",
  "description": "像媒体嗅探器一样自动捕获网页视频；支持 MP4/WebM 直存、HLS/M3U8/DASH 清晰度分析、分片并发下载与自动合并。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
