{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.5.7",
  "description": "网页媒体嗅探下载器：播放后识别，优先主播放清单；当 HLS 子播放清单不提供分辨率时，用本地 FFmpeg 探测真实画质并显示当前下载分辨率。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "tabCapture",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background_v6.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
