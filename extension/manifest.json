{
  "manifest_version": 3,
  "name": "OmniFetch 全平台下载助手",
  "version": "0.5.9",
  "description": "网页媒体嗅探下载器：捕获 M3U8 后优先使用 8 并发原生分片下载，兼容部分 FFmpeg 无法直接打开的 CDN 媒体分片；继续优先最高画质、显示真实 720P/1080P/2160P，并支持单独音频。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "tabCapture",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background_v6.js"
  },
  "action": {
    "default_title": "OmniFetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
